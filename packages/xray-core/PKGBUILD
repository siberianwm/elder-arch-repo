# Локальный пакет: Xray-core в паре с версией на дедике.
# Отличия от AUR-пакетов:
#   * бинарь кладётся в /usr/bin/xray (в PATH), а не в /usr/lib/x-ui/bin/
#   * нет post_install-хуков, качающих geo-базы со сторонних репозиториев —
#     свои ассеты ставим отдельно и осознанно
#   * имя не пересекается с AUR (xray / xray-bin), чтобы paru не откатил
#     версию до последней «не-pre» (26.3.27)

pkgname=xray-core
pkgver=26.10.29
pkgrel=1
pkgdesc="Xray-core: VLESS/XHTTP/REALITY (сборка из исходников XTLS)"
arch=(x86_64 aarch64)
url="https://github.com/XTLS/Xray-core"
license=(MPL-2.0)
depends=(glibc)
makedepends=(go)
provides=(xray)
conflicts=(xray xray-bin)
options=(!debug)
source=("$url/archive/v$pkgver/Xray-core-$pkgver.tar.gz")
sha256sums=('ee22c6f21855f70a52e19bff02fa71f4b28ce071d83ff9154fafcaa0f315a642')
b2sums=('c5ec66e3cf6acd30f9f9abe96dd5fe0846e7b40c9734cfc2c2e5033e986dc312f616047f2740f0f44d821fd9b6f2885b2601b21db8613ca927a2c77b5b825115')

build() {
  cd "Xray-core-$pkgver"
  export GOCACHE="$srcdir/go-build"
  export GOPATH="$srcdir/go"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export CGO_ENABLED=1
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -buildvcs=false"
  go build -v -o build/xray \
    -ldflags="-linkmode=external -s -w -buildid= -extldflags=-Wl,-z,relro,-z,now" \
    ./main
}

check() {
  cd "Xray-core-$pkgver"
  ./build/xray version
}

package() {
  cd "Xray-core-$pkgver"
  install -vDm755 build/xray "$pkgdir/usr/bin/xray"
  install -vDm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  # каталог под geo-ассеты; сами файлы ставятся отдельно
  install -vdm755 "$pkgdir/usr/share/xray"
}
